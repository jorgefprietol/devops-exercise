                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/DevOps",
            "description": "Envía primero una petición válida desde el script y repite el JWT en esta petición. Debe devolver 409. No depende de otra petición de la colección.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"This is a test\",\n  \"to\": \"Juan Perez\",\n  \"from\": \"Rita Asturia\",\n  \"timeToLifeSec\": 45\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Consume primero el mismo JWT: este caso funciona también al pulsar Send de forma individual.",
                  "const first = await new Promise((resolve, reject) => pm.sendRequest({",
                  "    url: pm.environment.get('base_url').replace(/\\/$/, '') + '/DevOps',",
                  "    method: 'POST',",
                  "    header: {'Content-Type': 'application/json', 'X-Parse-REST-API-Key': pm.environment.get('api_key'), 'X-JWT-KWY': pm.variables.get('jwt')},",
                  "    body: {mode: 'raw', raw: JSON.stringify({message:'This is a test', to:'Juan Perez', from:'Rita Asturia', timeToLifeSec:45})}",
                  "}, (error, response) => error ? reject(error) : resolve(response)));",
                  "pm.test('Primera utilización del JWT aceptada', () => pm.expect(first.code).to.eql(200));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP esperado: 409', () => pm.expect(pm.response.code).to.eql(409));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
