{
  "info": {
    "name": "Ejercicio DevOps - Jorge Prieto",
    "description": "Colección de estudio y validación de POST /DevOps. Importa un entorno privado generado por scripts/export_postman_env.py. El JWT HS256 se genera con Web Crypto y un jti nuevo antes de cada petición. Requiere Postman actualizado. HTTPS público conserva la validación de certificados. Para el certificado autofirmado de localhost consulta postman/README.md. TRACE debe responder 405 y el texto exacto ERROR; HEAD responde sin cuerpo por el protocolo HTTP. Utiliza la entrada pública Pinggy actual, porque Cloudflare intercepta TRACE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.environment.get('base_url');",
          "const secret = pm.environment.get('jwt_secret');",
          "if (!base || !secret || !pm.environment.get('api_key')) {",
          "    throw new Error('Importa y selecciona un entorno privado de DevOps con base_url, api_key y jwt_secret.');",
          "}",
          "if (!base.startsWith('https://')) throw new Error('La URL debe utilizar HTTPS.');",
          "function encode(bytes) {",
          "    return btoa(String.fromCharCode(...bytes)).replace(/=/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "}",
          "const utf8 = new TextEncoder();",
          "const now = Math.floor(Date.now() / 1000);",
          "const header = encode(utf8.encode(JSON.stringify({alg: 'HS256', typ: 'JWT'})));",
          "const payload = encode(utf8.encode(JSON.stringify({",
          "    iss: 'devops-candidate', aud: 'devops-api', sub: 'postman',",
          "    iat: now, nbf: now, exp: now + 300,",
          "    jti: pm.variables.replaceIn('{{$guid}}').replace(/-/g, '')",
          "})));",
          "const unsigned = header + '.' + payload;",
          "const key = await crypto.subtle.importKey('raw', utf8.encode(secret), {name: 'HMAC', hash: 'SHA-256'}, false, ['sign']);",
          "const signature = await crypto.subtle.sign('HMAC', key, utf8.encode(unsigned));",
          "pm.variables.set('jwt', unsigned + '.' + encode(new Uint8Array(signature)));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Petición válida",
      "item": [
        {
          "name": "POST - Enviar mensaje (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Parse-REST-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "X-JWT-KWY",
                "value": "{{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/DevOps",
            "description": "Pulsa Send. Se genera automáticamente un JWT nuevo para cada envío. No necesitas editar los encabezados.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"This is a test\",\n  \"to\": \"Juan Perez\",\n  \"from\": \"Rita Asturia\",\n  \"timeToLifeSec\": 45\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado HTTP esperado: 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('Respuesta exacta del ejercicio', () => pm.expect(pm.response.json()).to.eql({message: 'Hello Juan Perez your message will be sent'}));",
                  "pm.test('Respuesta sin caché', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "pm.test('Protección contra detección de contenido', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
